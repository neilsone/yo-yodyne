---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContentCard from '../../components/ContentCard.astro';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.status !== 'archived')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Projects">
  <section>
    <h1>Projects</h1>
    <p class="intro muted">Active and completed builds.</p>

    {projects.length > 0 ? (
      <div class="posts">
        {projects.map((project) => (
          <ContentCard
            title={project.data.title}
            href={project.data.subdomain
              ? `https://${project.data.subdomain}.yo-yodyne.com`
              : `/labs/projects/${project.id}/`}
            date={project.data.date}
            description={project.data.tagline}
            tags={project.data.tags}
          />
        ))}
      </div>
    ) : (
      <p class="empty muted">Projects are underway. Check back.</p>
    )}
  </section>
</Base>

<style>
  h1 { margin-bottom: var(--space-sm); }
  .intro { margin-bottom: var(--space-xl); }
  .empty { margin-top: var(--space-xl); }
</style>
