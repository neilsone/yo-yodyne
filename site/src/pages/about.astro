---
import Base from '../layouts/Base.astro';
---
<Base title="About" description="About Yo-Yodyne Labs and Neilson P. Eney.">
  <section class="about">
    <h1>About</h1>
    <p>
      Yo-Yodyne Labs is the research and creative production hub of Neilson P. Eney —
      an independent researcher and software engineer with thirty years of experience
      building systems that work.
    </p>
    <p>
      The work here spans from scientific inquiry to software engineering to creative
      production. Research is presented in two registers: informal treatments that invite
      a broader audience into the ideas, and technical papers that show the mathematics
      and methodology underneath.
    </p>
    <p>
      Individual projects live on their own subdomains. This site is the connective tissue.
    </p>
  </section>
</Base>

<style>
  .about {
    padding: var(--space-xl) 0;
  }

  .about h1 {
    margin-bottom: var(--space-xl);
  }

  .about p {
    margin-bottom: var(--space-lg);
  }
</style>
