---
import LogoMark from './LogoMark.astro';
const year = new Date().getFullYear();
---
<footer>
  <div class="footer-content">
    <LogoMark size={16} class="footer-mark" />
    <p class="muted small">&copy; {year} Neilson P. Eney &middot; Yo-Yodyne</p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-2xl);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--shadow);
  }

  .footer-content {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .footer-content :global(.footer-mark) {
    color: var(--shadow);
  }
</style>
