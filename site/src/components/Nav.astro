---
import LogoMark from './LogoMark.astro';
---
<nav>
  <a href="/labs/" class="logo">
    <LogoMark size={22} />
    <span>Yo-Yodyne Labs</span>
  </a>
  <div class="links">
    <a href="/labs/research/">Research</a>
    <a href="/labs/experiments/">Experiments</a>
    <a href="/labs/projects/">Projects</a>
    <a href="/labs/about/">About</a>
  </div>
</nav>

<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--shadow);
    margin-bottom: var(--space-xl);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 300;
    text-decoration: none;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .logo :global(.logo-mark) {
    color: var(--evergreen);
    transition: color var(--duration) var(--ease);
  }

  .logo:hover :global(.logo-mark) {
    color: var(--accent);
  }

  .links {
    display: flex;
    gap: var(--space-lg);
  }

  .links a {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--stone);
    transition: color var(--duration) var(--ease);
  }

  .links a:hover {
    color: var(--ink);
  }

  @media (max-width: 600px) {
    nav {
      flex-direction: column;
      gap: var(--space-md);
    }
    .links {
      gap: var(--space-md);
    }
  }
</style>
