---
// LogoMark — inline SVG of the refined Yo-Yodyne mark
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---
<svg
  class:list={['logo-mark', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 50 44"
  width={size}
  height={size * 44 / 50}
  aria-hidden="true"
>
  <g fill="currentColor">
    <polygon points="14.25,0.5 35.88,0.5 32.39,6.4 17.85,6.4"/>
    <polygon points="11.78,1.55 15.46,7.94 7.34,22 15.46,36.06 11.78,42.45 0,22"/>
    <polygon points="38.22,1.55 50,22 38.22,42.45 34.54,36.06 42.66,22 34.54,7.94"/>
    <polygon points="17.85,37.6 32.39,37.6 35.88,43.5 14.25,43.5"/>
  </g>
  <circle cx="25" cy="22" r="3.7" fill="var(--accent)"/>
</svg>
